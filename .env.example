# ====================================================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL - IAM DB)
# ====================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/erp_auth_db

# Rol de EJECUCIÓN: sin privilegios de propietario y con NOBYPASSRLS, de
# modo que la política de Row-Level Security le sea aplicable. El propietario
# de una tabla elude su propia política, de modo que usar el mismo rol para
# la aplicación y para las migraciones dejaba el aislamiento sin efecto.
ERP_APP_DB_USER=erp_app
ERP_APP_DB_PASSWORD=cambiar_en_cada_entorno

# Rol PROPIETARIO: lo usan únicamente las migraciones de Flyway, que
# necesitan permisos de DDL. Lo crea la migración V4.
SPRING_FLYWAY_USER=auth_user
SPRING_FLYWAY_PASSWORD=cambiar_en_cada_entorno

# ====================================================================
# SERVIDOR Y PUERTO
# ====================================================================
SERVER_PORT=8081

# ====================================================================
# SEGURIDAD, CRIPTOGRAFÍA Y JWT (QA-5)
# ====================================================================
JWT_ISSUER=https://auth.erp-automotriz.com
JWT_KEY_ID=erp-auth-key-2026-v1
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_PASSWORD_RESET_EXPIRATION_MINUTES=30

# ====================================================================
# CONTROL DE FUERZA BRUTA Y BLOQUEO DE CUENTA (QA-5)
# ====================================================================
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
